# Copy to .env (docker compose reads .env automatically) and adjust for this host.
# Everything here has a sane default in docker-compose.yml; only set what you need to change.

# Port the dashboard/gateway is reachable on from the host.
APP_PORT=3100

# Shared secret for /api/* and /mcp*; leave unset to run without auth (localhost only).
# AUTH_TOKEN=

# Host directories bind-mounted into the app container so its spawned stdio servers resolve
# the same absolute paths the dashboard has stored for them (gitlab-mcp, vault-mcp-server,
# mongo-mcp, the hasaki-work-mcp Python venv, …). Change these if your MCP server binaries/
# scripts live somewhere else on this machine.
MCP_DIR=/home/dev/Documents/mcp
GOBIN_DIR=/home/dev/go/bin
